{
  "cleanUrls": true,
  "headers": [
    {"source": "/_astro/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/mascote/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/img/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/(dados|fotos|fotos-dificil|escudos|kits|lendas|novos|futgeo|passagens|top100|camisas|atuais|posicoes|entrosa|fotos/s[0-9]+).json", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/(favicon.png|og-arena.png)", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]}
  ]
}
