---
import "../styles/global.css";
import img0 from "../assets/bdc95b0ba.webp?url";
import bode from "../assets/fig-bode.png?url";
import socIg from "../assets/soc-instagram.png?url";
import socTt from "../assets/soc-tiktok.png?url";
import socX from "../assets/soc-x.png?url";
import socDc from "../assets/soc-discord.png?url";
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Arena The Fenômeno: vinte e dois mini games de futebol num lugar só. Draft, Leilão, Maleta, Reconstruindo, Camisa e Conta, Carreira, Questionamentos, Forca, Jogo da Velha multiplayer, Entrosamento, Pirâmide, Top 10, FutGeo, Quem é?, Grade, Conexões, Bodle, Impostor, Escudo, Bingo e Mais Velho? e Top 100.">
<meta property="og:title" content="Arena The Fenômeno">
<meta property="og:description" content="A arena dos mini games do The Fenômeno. Vinte e dois jogos de futebol, desafios novos todo dia.">
<meta property="og:image" content="/og-arena.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="/favicon.png">
<style is:global>:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}img{max-width:100%}[hidden]{display:none!important}</style>
<title>Arena The Fenômeno</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Bebas+Neue&family=Inria+Sans:wght@300&family=Inria+Serif:wght@700&family=Instrument+Serif&family=Inter:wght@400;600;700;800&family=Roboto:wght@500;700&display=swap">
</head>
<body>
<div id="boot"><div><img src={img0} alt=""><b>AQUECENDO O BODE…</b></div></div>

<header class="top fig"><div class="wrap">
  <button class="brand" id="home" aria-label="Início"><img src={bode} alt="" width="78" height="64"><span class="d">ARENA THE FENOMENO</span></button>
  <nav class="soc" aria-label="Redes do The Fenômeno">
    <a href="https://www.instagram.com/_thefenomeno/" target="_blank" rel="noopener" aria-label="Instagram do The Fenômeno" title="Instagram"><img src={socIg} alt="" width="30" height="30"></a>
    <a href="https://www.tiktok.com/@_thefenomeno" target="_blank" rel="noopener" aria-label="TikTok do The Fenômeno" title="TikTok"><img src={socTt} alt="" width="30" height="30"></a>
    <a href="https://x.com/othefenomeno?s=11" target="_blank" rel="noopener" aria-label="X do The Fenômeno" title="X"><img src={socX} alt="" width="30" height="30"></a>
    <a href="https://discord.gg/WVcbBvSfx" target="_blank" rel="noopener" aria-label="Discord do The Fenômeno" title="Discord"><img src={socDc} alt="" width="30" height="30"></a>
  </nav>
  <div class="hrow"><span class="pill" id="todayPill"><span class="dot"></span><span id="todayScore">0 ganhas · 0 perdidas</span></span><button type="button" class="mechip" id="meBtn" aria-label="Meu usuário e vestiário"></button></div>
</div></header>

<main id="app" class="wrap"></main>

<footer><div class="wrap">Fotos, escudos e dados: <a href="https://github.com/TheSMF-Group/assets" target="_blank" rel="noopener">TheSMF-Group/assets</a> e <a href="https://github.com/TheSMF-Group/thefenomeno-assets" target="_blank" rel="noopener">thefenomeno-assets</a>. "Último clube" é o clube da temporada mais recente do jogador na base. Entrosamento, Pirâmide e Top 10 são inspirados no futbol11; as listas foram montadas à mão com números até o início de 2025/26. Desafios novos todo dia à meia-noite.</div></footer>
<script>import "../main";</script>
  <!-- Cloudflare Web Analytics (grátis, sem cookie): páginas e visitas no admin.thefenomeno.com -->
<script defer is:inline src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "02ca75c3ec654a0ca55c12529804db37"}'></script>
</body>
</html>
