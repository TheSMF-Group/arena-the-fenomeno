---
import "../styles/global.css";
import img0 from "../assets/bdc95b0ba.webp?url";
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Arena The Fenômeno: vinte e dois mini games de futebol num lugar só. Draft, Leilão, Maleta, Reconstruindo, Camisa e Conta, Carreira, Questionamentos, Forca, Jogo da Velha multiplayer, Entrosamento, Pirâmide, Top 10, FutGeo, Quem é?, Grade, Conexões, Bodle, Impostor, Escudo, Bingo e Mais Velho? e Top 100.">
<meta property="og:title" content="Arena The Fenômeno">
<meta property="og:description" content="A arena dos mini games do The Fenômeno. Vinte e dois jogos de futebol, desafios novos todo dia.">
<meta property="og:image" content="/og.png">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="/favicon.png">
<style is:global>:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}img{max-width:100%}[hidden]{display:none!important}</style>
<title>Arena The Fenômeno</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600;700;800&display=swap">
</head>
<body>
<div id="boot"><div><img src={img0} alt=""><b>AQUECENDO O BODE…</b></div></div>

<header class="top"><div class="wrap">
  <div class="hbar">
    <button class="brand" id="home" aria-label="Início"><img src={img0} alt=""><span class="d">ARENA THE <b>FENÔMENO</b></span><small>MINI GAMES DE FUTEBOL</small></button>
    <nav class="soc" aria-label="Redes do The Fenômeno">
      <a href="https://www.instagram.com/_thefenomeno/" target="_blank" rel="noopener" aria-label="Instagram do The Fenômeno" title="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg></a>
      <a href="https://www.tiktok.com/@_thefenomeno" target="_blank" rel="noopener" aria-label="TikTok do The Fenômeno" title="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg></a>
    </nav>
  </div>
  <span class="pill" id="todayPill"><span class="dot"></span><span id="todayScore">0 ganhas · 0 perdidas</span></span>
</div></header>

<main id="app" class="wrap"></main>

<footer><div class="wrap">Fotos, escudos e dados: <a href="https://github.com/TheSMF-Group/assets" target="_blank" rel="noopener">TheSMF-Group/assets</a> e <a href="https://github.com/TheSMF-Group/thefenomeno-assets" target="_blank" rel="noopener">thefenomeno-assets</a>. "Último clube" é o clube da temporada mais recente do jogador na base. Entrosamento, Pirâmide e Top 10 são inspirados no futbol11; as listas foram montadas à mão com números até o início de 2025/26. Desafios novos todo dia à meia-noite.</div></footer>
<script>import "../main";</script>
</body>
</html>
