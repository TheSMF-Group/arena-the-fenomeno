---
import "../styles/global.css";
import img0 from "../assets/bdc95b0ba.webp?url";
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Central The Fenômeno de Mini Games: vinte e dois mini games de futebol num lugar só. Draft, Leilão, Maleta, Reconstruindo, Camisa e Conta, Carreira, Questionamentos, Forca, Jogo da Velha multiplayer, Entrosamento, Pirâmide, Top 10, FutGeo, Quem é?, Grade, Conexões, Bodle, Impostor, Escudo, Bingo e Mais Velho? e Top 100.">
<meta property="og:title" content="Central The Fenômeno de Mini Games">
<meta property="og:description" content="Todos os mini games de futebol do The Fenômeno num lugar só. Vinte e dois jogos, desafios novos todo dia.">
<meta property="og:image" content="/og.png">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="/favicon.png">
<style is:global>:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}img{max-width:100%}[hidden]{display:none!important}</style>
<title>Central The Fenômeno de Mini Games</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
</head>
<body>
<div id="boot"><div><img src={img0} alt=""><b>AQUECENDO O BODE…</b></div></div>

<header class="top"><div class="wrap">
  <button class="brand" id="home" aria-label="Início"><img src={img0} alt=""><span class="d">THE <b>FENÔMENO</b></span><small>CENTRAL DE MINI GAMES</small></button>
  <span class="spacer"></span>
  <span class="pill" id="todayPill"><span class="dot"></span><span id="todayScore">0 ganhas · 0 perdidas</span></span>
</div></header>

<main id="app" class="wrap"></main>

<footer><div class="wrap">Fotos, escudos e dados: <a href="https://github.com/TheSMF-Group/assets" target="_blank" rel="noopener">TheSMF-Group/assets</a> e <a href="https://github.com/TheSMF-Group/thefenomeno-assets" target="_blank" rel="noopener">thefenomeno-assets</a>. "Último clube" é o clube da temporada mais recente do jogador na base. Entrosamento, Pirâmide e Top 10 são inspirados no futbol11; as listas foram montadas à mão com números até o início de 2025/26. Desafios novos todo dia à meia-noite.</div></footer>
<script>import "../main";</script>
</body>
</html>
